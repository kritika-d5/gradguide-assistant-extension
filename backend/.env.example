# Copy this file to backend/.env and fill in ONE key. backend/.env is git ignored.
# Without any key the panel still works, using its in browser rules only.

# Groq (free tier): create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Or Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Provider is picked from whichever key is set (Groq first); force it with groq,
# anthropic or none. Model defaults: groq -> openai/gpt-oss-120b, anthropic -> claude-opus-5-5
# LLM_PROVIDER=groq
# LLM_MODEL=
