{
  "manifest_version": 3,
  "name": "GradGuide Counsellor Assist",
  "version": "0.1.0",
  "description": "Private course recommendation side panel for counsellors during a live Google Meet session.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["extract.js", "captions.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Open GradGuide Assist" }
}
